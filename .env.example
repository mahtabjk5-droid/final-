# Server Port & Public Domain
PORT=3000
NODE_ENV=production
APP_URL="https://bolmizan.pk"
AUTH_SESSION_SECRET="replace_with_64_char_random_hex_secret"

# 1. Google Gemini 2.5 Flash API Key (Multilingual Urdu/Sindhi/English Voice-to-Hisab)
GEMINI_API_KEY="YOUR_GOOGLE_GEMINI_API_KEY"

# 2. Official Meta WhatsApp Business Cloud API (Automatic Server-to-Phone Parchi & OTP)
WHATSAPP_CLOUD_TOKEN="YOUR_META_WHATSAPP_PERMANENT_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_META_PHONE_NUMBER_ID"

# 3. JazzCash Merchant Credentials (Live Payment Return HMAC-SHA256 Verification)
JAZZCASH_MERCHANT_ID="YOUR_JAZZCASH_MERCHANT_ID"
JAZZCASH_PASSWORD="YOUR_JAZZCASH_API_PASSWORD"
JAZZCASH_INTEGRITY_SALT="YOUR_JAZZCASH_INTEGRITY_SALT"

# 4. Default SBP Raast IBAN / Merchant Account
DEFAULT_RAAST_IBAN="PK36SCBL0000001123456702"
